# Supabase (client-safe, pubblica)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps Platform (client-safe, ristretta per bundle id / package name)
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# PostHog (client-safe)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# EAS
EAS_PROJECT_ID=

# ============================================================
# SECRET — SOLO SERVER SIDE (Supabase Edge Functions secrets)
# NON usare prefisso EXPO_PUBLIC_, NON includere nel client
# Impostare con: supabase secrets set NOME=valore
# ============================================================
# OPENAI_API_KEY=
# GOOGLE_ROUTES_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
